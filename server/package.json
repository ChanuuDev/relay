{
  "name": "@relay/server",
  "version": "1.0.0",
  "private": true,
  "description": "Relay 원격 서버: NestJS + PostgreSQL. 세션·메모·계산 이력·지정 폴더 파일을 Bearer 토큰으로 제공한다",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "cli": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "migrate:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/schedule": "^6.0.0",
    "@relay/core": "1.0.0",
    "drizzle-orm": "^0.44.0",
    "express": "^5.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@swc/core": "^1.11.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.3",
    "drizzle-kit": "^0.31.0",
    "supertest": "^7.1.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.0",
    "vitest": "^3.2.0"
  }
}
